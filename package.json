{
  "name": "vue-component-lib",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --coverage",
    "test:coverage": "vitest run --coverage --reporter=html --outputDir=reports/coverage",
    "quality-check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "prepare": "husky",
    "report:coverage": "vitest run --coverage --reporter=html --outputDir=reports/coverage",
    "report:audit": "npm audit --registry=https://registry.npmjs.org",
    "scan:deps": "depcheck",
    "scan:secrets": "npx gitleaks detect --source . --no-banner",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "main": "./dist/vue-component-lib.cjs",
  "module": "./dist/vue-component-lib.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-component-lib.js",
      "require": "./dist/vue-component-lib.cjs"
    },
    "./basic": {
      "types": "./src/components/basic/index.ts",
      "import": "./src/components/basic/index.ts"
    },
    "./data": {
      "types": "./src/components/data/index.ts",
      "import": "./src/components/data/index.ts"
    },
    "./form": {
      "types": "./src/components/form/index.ts",
      "import": "./src/components/form/index.ts"
    },
    "./feedback": {
      "types": "./src/components/feedback/index.ts",
      "import": "./src/components/feedback/index.ts"
    },
    "./nav": {
      "types": "./src/components/nav/index.ts",
      "import": "./src/components/nav/index.ts"
    },
    "./layout": {
      "types": "./src/components/layout/index.ts",
      "import": "./src/components/layout/index.ts"
    },
    "./chart": {
      "types": "./src/components/chart/index.ts",
      "import": "./src/components/chart/index.ts"
    },
    "./login": {
      "types": "./src/components/login/index.ts",
      "import": "./src/components/login/index.ts"
    },
    "./storage": {
      "types": "./src/components/storage/index.ts",
      "import": "./src/components/storage/index.ts"
    },
    "./wc": {
      "types": "./src/components/wc/index.ts",
      "import": "./src/components/wc/index.ts"
    },
    "./i18n": {
      "types": "./src/components/_internal/i18n.ts",
      "import": "./src/components/_internal/i18n.ts"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/components",
    "README.md"
  ],
  "peerDependencies": {
    "echarts": "^5.0.0 || ^6.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.0",
    "@lucide/vue": "^1.21.0",
    "@vuemap/vue-amap": "^2.1.17",
    "echarts-wordcloud": "^2.1.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "vue-i18n": "^9.14.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zxing-wasm": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "aws4": "^1.13.2",
    "echarts": "^6.1.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "pinia": "^2.1.7",
    "prettier": "^3.9.6",
    "selfsigned": "^5.5.0",
    "typescript": "~5.4.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.4.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.3.0",
    "vue-tsc": "^2.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "glob": "10.5.0",
    "brace-expansion": "2.1.4",
    "echarts-wordcloud": {
      "echarts": "$echarts"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss}": [
      "prettier --write"
    ]
  }
}
