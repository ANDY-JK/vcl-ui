{
  "name": "vcl-ui",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "npm run clean",
    "build": "vite build",
    "verify:pkg": "node scripts/verify-pkg.mjs",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --coverage",
    "quality-check": "npm run typecheck && npm run lint && npm run check:constants && npm run check:css-tokens && npm run check:i18n && npm run check:demo-props && npm run test:unit && npm run build && npm run verify:pkg && npm run test:e2e",
    "prepare": "husky",
    "report:audit": "npm audit --registry=https://registry.npmjs.org",
    "scan:deps": "depcheck",
    "scan:secrets": "npx gitleaks detect --source . --no-banner",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui",
    "check:constants": "node scripts/check-constants.mjs",
    "changelog": "node scripts/gen-changelog.mjs",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:demo-props": "node scripts/check-demo-props.mjs"
  },
  "main": "./dist/vcl-ui.cjs",
  "module": "./dist/vcl-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs",
      "default": "./dist/vcl-ui.js"
    },
    "./css": "./dist/vcl-ui.css",
    "./basic": {
      "types": "./dist/basic/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./nav": {
      "types": "./dist/nav/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./login": {
      "types": "./dist/login/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./wc": {
      "types": "./dist/wc/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./i18n": {
      "types": "./dist/_internal/i18n.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./form-builder": {
      "types": "./dist/form-builder/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./amap": {
      "types": "./dist/amap/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./route-planner": {
      "types": "./dist/route-planner/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "echarts": "^5.0.0 || ^6.0.0",
    "echarts-wordcloud": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "echarts-wordcloud": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@iconify/vue": "^4.1.0",
    "@lucide/vue": "^1.21.0",
    "@vuemap/vue-amap": "^2.1.17",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "morphicons": "^1.7.1",
    "qrcode": "^1.5.4",
    "vue-i18n": "^9.14.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zxing-wasm": "^3.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "aws4": "^1.13.2",
    "echarts": "^6.1.0",
    "echarts-wordcloud": "^2.1.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "selfsigned": "^5.5.0",
    "typescript": "~5.4.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.4.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.3.0",
    "vue-tsc": "^2.0.0",
    "vue34": "npm:vue@~3.4.38"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "glob": "10.5.0",
    "brace-expansion": "2.1.4",
    "echarts-wordcloud": {
      "echarts": "$echarts"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss}": [
      "prettier --write"
    ]
  }
}
