{
  "name": "vcl-ui",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "npm run clean",
    "build": "vite build && node scripts/emit-css.mjs && node scripts/gen-third-party-licenses.mjs",
    "verify:pkg": "node scripts/verify-pkg.mjs",
    "gen:licenses": "node scripts/gen-third-party-licenses.mjs",
    "check:licenses": "node scripts/gen-third-party-licenses.mjs --check",
    "check:vendor-data": "node scripts/check-vendor-data.mjs",
    "check:vendor-vulns": "node scripts/check-vendor-vulns.mjs",
    "gen:zxing-wasm-data": "node scripts/gen-zxing-wasm-data.mjs",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src tests scripts --max-warnings 147",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --coverage && node scripts/mark-coverage-full-run.mjs",
    "bench": "node scripts/bench.mjs",
    "quality-check": "node scripts/quality-check.mjs",
    "prepare": "husky",
    "report:audit": "npm audit --registry=https://registry.npmjs.org",
    "release:dry-run": "npm publish --dry-run --registry https://registry.npmjs.org",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui",
    "check:constants": "node scripts/check-constants.mjs",
    "check:result-consumed": "node scripts/check-result-consumed.mjs",
    "check:no-cycles": "node scripts/check-no-cycles.mjs",
    "check:icons": "node scripts/gen-lucide-subset.mjs --check",
    "check:icon-names": "node scripts/check-icon-names.mjs",
    "check:mutation-tool": "node scripts/mutation-control.mjs --self-test",
    "check:mutation-audit": "node scripts/mutation-audit.mjs --check-manifest",
    "check:hover-guard": "node scripts/wrap-hover-media.mjs --check",
    "check:tab-sequence": "node scripts/check-tab-sequence.mjs",
    "check:review-appendix": "node scripts/check-review-appendix.mjs",
    "check:gate-wiring": "node scripts/check-gate-wiring.mjs",
    "fix:hover-guard": "node scripts/wrap-hover-media.mjs --write",
    "mutation-audit": "node scripts/mutation-audit.mjs",
    "mutation-control": "node scripts/mutation-control.mjs",
    "check:test-skips": "node scripts/check-test-skips.mjs",
    "changelog": "node scripts/gen-changelog.mjs",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "check:contrast": "node scripts/contrast-audit.mjs",
    "check:css-breakpoints": "node scripts/check-css-breakpoints.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:demo-props": "node scripts/check-demo-props.mjs",
    "check:error-demo": "node scripts/check-error-demo.mjs",
    "check:template-statements": "node scripts/check-template-statements.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:governance-index": "node scripts/gen-governance-index.mjs",
    "gen:theme": "node scripts/gen-theme.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "check:coverage-domains": "node scripts/check-coverage-domains.mjs",
    "smoke:entries": "node scripts/smoke-entries.mjs",
    "check:doc-completeness": "node scripts/check-doc-completeness.mjs",
    "check:esc-consume": "node scripts/check-esc-consume.mjs",
    "check:public-surface": "node scripts/check-public-surface.mjs",
    "check:async-assert": "node scripts/check-async-assert.mjs",
    "check:debt-evidence": "node scripts/check-debt-evidence.mjs",
    "check:review-history": "node scripts/check-review-history.mjs",
    "check:canwrite-usage": "node scripts/check-canwrite-usage.mjs",
    "check:edit-single-writer": "node scripts/check-edit-single-writer.mjs",
    "check:css-fonts": "node scripts/check-css-fonts.mjs",
    "check:css-scale": "node scripts/check-css-scale.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "gen:demo-assets": "node scripts/gen-demo-assets.mjs",
    "apply-scale": "node scripts/apply-scale.mjs --write",
    "quick-check": "node scripts/quality-check.mjs --quick",
    "check:release-consistency": "node scripts/check-release-consistency.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "bench:baseline": "node scripts/gen-bench-baseline.mjs",
    "bench:check": "node scripts/bench.mjs --check",
    "test:noise:baseline": "node scripts/check-console-noise.mjs --baseline",
    "test:noise": "node scripts/check-console-noise.mjs",
    "check:console-noise": "node scripts/check-console-noise.mjs --no-run",
    "pretest:unit": "node scripts/check-console-noise.mjs --clear",
    "gen:facts": "node scripts/gen-facts.mjs",
    "check:facts": "node scripts/check-facts.mjs",
    "check:tech-debt": "node scripts/check-tech-debt.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:rtl-semantics": "node scripts/check-rtl-semantics.mjs",
    "sync:demo-table": "node scripts/sync-demo-table.mjs"
  },
  "main": "./dist/vcl-ui.cjs",
  "module": "./dist/vcl-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs",
      "default": "./dist/vcl-ui.js"
    },
    "./css": "./dist/vcl-ui.css",
    "./basic": {
      "types": "./dist/basic/index.d.ts",
      "import": "./dist/basic/index.js",
      "require": "./dist/basic/index.cjs"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "require": "./dist/data/index.cjs"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js",
      "require": "./dist/form/index.cjs"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "import": "./dist/feedback/index.js",
      "require": "./dist/feedback/index.cjs"
    },
    "./nav": {
      "types": "./dist/nav/index.d.ts",
      "import": "./dist/nav/index.js",
      "require": "./dist/nav/index.cjs"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js",
      "require": "./dist/layout/index.cjs"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart/index.js",
      "require": "./dist/chart/index.cjs"
    },
    "./login": {
      "types": "./dist/login/index.d.ts",
      "import": "./dist/login/index.js",
      "require": "./dist/login/index.cjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "require": "./dist/storage/index.cjs"
    },
    "./wc": {
      "types": "./dist/wc/index.d.ts",
      "import": "./dist/wc/index.js",
      "require": "./dist/wc/index.cjs"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/vcl-ui.js",
      "require": "./dist/vcl-ui.cjs"
    },
    "./form-builder": {
      "types": "./dist/form-builder/index.d.ts",
      "import": "./dist/form-builder/index.js",
      "require": "./dist/form-builder/index.cjs"
    },
    "./amap": {
      "types": "./dist/amap/index.d.ts",
      "import": "./dist/amap/index.js",
      "require": "./dist/amap/index.cjs"
    },
    "./route-planner": {
      "types": "./dist/route-planner/index.d.ts",
      "import": "./dist/route-planner/index.js",
      "require": "./dist/route-planner/index.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "echarts": "^5.0.0 || ^6.0.0",
    "echarts-wordcloud": "^2.1.0",
    "html2canvas": "^1.4.1",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "echarts-wordcloud": {
      "optional": true
    },
    "html2canvas": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@lucide/vue": "^1.21.0",
    "@vuemap/vue-amap": "^2.1.17",
    "jszip": "^3.10.1",
    "morphicons": "^1.7.1",
    "qrcode": "^1.5.4",
    "vue-i18n": "^9.14.5",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.4.11",
    "aws4": "^1.13.2",
    "echarts": "^6.1.0",
    "echarts-wordcloud": "^2.1.0",
    "eslint-plugin-vue": "^10.10.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "selfsigned": "^5.5.0",
    "typescript": "~5.4.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.3.0",
    "vue-tsc": "^2.0.0",
    "vue34": "npm:vue@~3.4.38",
    "html2canvas": "^1.4.1"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "glob": "10.5.0",
    "brace-expansion": "2.1.7",
    "echarts-wordcloud": {
      "echarts": "$echarts"
    },
    "vite": "$vite"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss}": [
      "prettier --write"
    ]
  }
}
