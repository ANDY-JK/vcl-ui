# 环境变量样例——复制为 .env.local 填入真实值（.env.local 已 gitignore，禁止提交）
# 注意：VITE_ 前端变量会打进产物，AK/SK 仅限内部工具/私有部署使用

# ===== Supabase 云端存储（可选后端之一） =====
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_SUPABASE_BUCKET=contracts

# ===== S3 兼容对象存储（缤纷云 Bitiful 等，推荐） =====
# endpoint 填桶级访问域名；region 缤纷云不校验（us-east-1 即可）
VITE_S3_ENDPOINT=https://<bucket>.s3.bitiful.net
VITE_S3_REGION=us-east-1
VITE_S3_BUCKET=<bucket>
VITE_S3_ACCESS_KEY_ID=<access-key-id>
VITE_S3_SECRET_ACCESS_KEY=<secret-access-key>

# ===== 高德地图 API Key =====
VITE_AMAP_KEY=<amap-key>
VITE_AMAP_SECRET=<amap-secret>
