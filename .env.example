# ═══════════════════════════════════════════════════════════════════════════
#  这是样例文件。真实值只填在同一个地方：项目根目录的 .env.local
#  （.env.local 已被 .gitignore 忽略，不会被提交，也不用记多个位置）
#
#  用法：第一次用把本文件复制成 .env.local，然后把下面每一项换成你自己的值。
#        以后换密钥，只改 .env.local 这一个文件。
#
#  ⚠ 两件必须知道的事
#  1) 这些值只在「开发模式」被组件库读取。正式构建组件库时不会打进产物
#     （实现见 src/components/_internal/env-guard.ts）。
#  2) 但这条保护只针对**本组件库**。**你自己的业务应用**如果把 VITE_ 开头的
#     变量配进去并构建，值仍然会打进你应用的前端产物、浏览器里可直接看到。
#     所以标了「🔴 不可进前端」的那几项，正规做法是放服务端代理，不要放前端。
#
#  换完/重置完密钥后的动作：rm -rf dist && npm run build
# ═══════════════════════════════════════════════════════════════════════════

# ===== 高德地图 =====

# 高德 JS Key —— 页面上那张地图能不能画出来
# 去哪拿：console.amap.com → 应用管理 → 我的应用 → 创建新 Key
#        Key 类型选「Web端(JS API)」
# 🟡 会进前端产物（JS Key 本身就是设计成可以给前端的，但要配域名白名单）
VITE_AMAP_KEY=

# 高德安全密钥 securityJsCode —— 和上面那把配对的第二把锁
# 去哪拿：同一个页面里，「安全密钥」那一栏
# 🔴 不可进前端。高德官方推荐的做法是配「安全代理地址 serviceHost」而不是
#    把它写进前端。这里填了只在开发模式生效，正式环境请走代理。
VITE_AMAP_SECRET=

# ===== Supabase 云端存储（可选后端之一，和下面 S3 二选一）=====

# 项目地址 —— Supabase 首页你的项目 → 左上角 Project ID 旁边的 URL
# 🟡 会进前端产物
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# 公开密钥 anon key —— 同一位置：Project Settings → Data API → keys
# 🟡 名义上是"公开"密钥，权限靠 RLS（行级安全策略）挡，所以 RLS 必须配好
VITE_SUPABASE_ANON_KEY=

# 存储桶名 —— Storage 页面里你建的桶的名字，例如 contracts
VITE_SUPABASE_BUCKET=

# ===== S3 兼容对象存储（缤纷云 Bitiful 等；配齐则优先于 Supabase）=====

# 桶级访问域名，形如 https://<桶名>.s3.bitiful.net
VITE_S3_ENDPOINT=
# 区域。缤纷云不校验，填 us-east-1 就行；AWS 系填真实区域
VITE_S3_REGION=us-east-1
# 桶名
VITE_S3_BUCKET=
# 🔴 不可进前端 —— 访问密钥 ID
VITE_S3_ACCESS_KEY_ID=
# 🔴 不可进前端 —— 私有密钥，泄露等于把整个桶的写权限交出去
VITE_S3_SECRET_ACCESS_KEY=
